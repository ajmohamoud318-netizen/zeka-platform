# Prefer .env.local for local secrets (gitignored). Vite also loads .env
# https://clerk.com/docs/react/getting-started/quickstart
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Local dev: leave empty (Vite proxies /api → localhost:4000).
# Cloudflare Pages: set to your hosted Express API origin, e.g. https://api.example.com (no trailing slash).
VITE_API_URL=
